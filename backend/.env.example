# ════════════════════════════════════════════════
#  Cilantra Backend – Environment Variables
# ════════════════════════════════════════════════
#
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
#
# ────────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://nikhilraj2908_db_user:0UUPvZZIIzuuygLz@cluster0.y4sm24m.mongodb.net/

# JWT secret – use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node environment
NODE_ENV=development

# Initial admin user (created on first run if no admin exists)
ADMIN_EMAIL=admin@cilantra.in
ADMIN_PASSWORD=Change_me_123!

